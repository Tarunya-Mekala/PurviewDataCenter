APP_NAME=AI Data Center Document Comparison

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_datacenter

# ============================================================
# LLM
# ============================================================

LLM_PROVIDER=qwen

# Put the OpenAI-compatible API base URL here.
# Example:
# https://your-provider-domain/v1
LLM_BASE_URL=YOUR_OPENAI_COMPATIBLE_BASE_URL

LLM_API_KEY=YOUR_API_KEY

LLM_MODEL=YOUR_QWEN_MODEL_NAME

LLM_TIMEOUT_SECONDS=180

LLM_TEMPERATURE=0.0


# ============================================================
# APPLICATION
# ============================================================

JWT_SECRET_KEY=change-this-in-production

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ============================================================
# SUPER ADMIN
# ============================================================

SUPERADMIN_EMAIL=admin@datacenter.ai

SUPERADMIN_PASSWORD=change-this-password

SUPERADMIN_NAME=Super Administrator